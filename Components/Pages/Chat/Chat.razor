@page "/chat"
@using Khonshu.ObamaGemini
@using Khonshu.ObamaGemini.AiDto
@using KhonshuFront.General
@inject IChatRepo ChatRepo
@inject ObamaAgentII ObamaAgent
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Chats</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="chat-page">
            <aside class="chat-sidebar @(sidebarOpen ? "open" : "")">
                <button class="chat-new" @onclick="OpenNewChatModal">+ Новый чат</button>
                <div class="chat-list">
                    @foreach (var chat in userChats)
                    {
                        <button class="chat-item @(chat.ChatId == selectedChatId ? "active" : "")"
                                @onclick="() => OpenChat(chat.ChatId)">@chat.Title</button>
                    }
                </div>
            </aside>

            @if (sidebarOpen)
            {
                <div class="chat-backdrop" @onclick="ToggleSidebar"></div>
            }

            <section class="chat-main">
                <div class="chat-topbar">
                    <button class="chat-toggle" @onclick="ToggleSidebar" aria-label="Список чатов">☰</button>
                    <span class="chat-topbar-title">@CurrentTitle</span>
                </div>

                <div class="chat-messages" @ref="messagesEl">
                    @if (messagesInCurrentChat is null)
                    {
                        <div class="chat-empty">Выберите чат слева или создайте новый</div>
                    }
                    else
                    {
                        @foreach (var m in messagesInCurrentChat)
                        {
                            <div class="msg @(IsMine(m) ? "user" : "assistant")">
                                <div class="msg-text">@m.MessageText</div>
                            </div>
                        }
                        @if (isAiThinking)
                        {
                            <div class="msg assistant">
                                <div class="msg-text thinking" aria-live="polite">
                                    Думает<span class="dots"><span>.</span><span>.</span><span>.</span></span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="chat-input">
                    <label class="chat-attach">
                        <InputFile OnChange="OnFileChange" accept="image/jpeg,image/png" class="chat-file-input" />
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.82-2.83l8.49-8.48" />
                        </svg>
                    </label>
                    @if (!String.IsNullOrWhiteSpace(selectedImageFileName))
                    {
                        <span class="chat-file-name" title="@selectedImageFileName">@selectedImageFileName</span>
                    }
                    <div class="chat-input-box">
                        <textarea rows="1" placeholder="Ваше сообщение..." @onkeydown="Callback"
                                  @bind="newMessageText" @bind:event="oninput"></textarea>
                        <button class="chat-send" @onclick="SendMessage" @onkeydown="Callback"
                                disabled="@(String.IsNullOrWhiteSpace(newMessageText) || isAiThinking)">↑</button>
                    </div>
                </div>
            </section>

        </div>
        <Modal @ref="newChatModal"
               Title="Новый чат"
               IsVerticallyCentered="true"
               Class="chat-new-modal"
               HeaderCssClass="chat-new-modal-header"
               BodyCssClass="chat-new-modal-body"
               FooterCssClass="chat-new-modal-footer"
               DialogCssClass="chat-new-modal">
            <BodyTemplate>
                <input class="form-control chat-modal-input" placeholder="Название чата" maxlength="100"
                       @bind="newChatTitle" @bind:event="oninput" />
            </BodyTemplate>
            <FooterTemplate>
                <button type="button" class="chat-modal-button chat-modal-button-secondary"
                        @onclick="CloseNewChatModal">Отмена</button>
                <button type="button" class="chat-modal-button chat-modal-button-primary"
                        @onclick="SaveNewChat" disabled="@String.IsNullOrWhiteSpace(newChatTitle)">Сохранить</button>
            </FooterTemplate>
        </Modal>
    </Authorized>
    <NotAuthorized>
        <div class="no-autohorized chat-empty">Вы не вошли в аккаунт!</div>
        <div class="chat-empty" style="padding:48px"><a href="/login">Войти</a></div>
    </NotAuthorized>
</AuthorizeView>

<Toasts class="p-3" Messages="toastMessages" AutoHide="true" StackLength="5" Placement="ToastsPlacement.TopRight" />


@code {
    private List<ToastMessage> toastMessages = [];

    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = null!;

    private List<ChatDto> userChats = [];
    private List<ViewMessageDto>? messagesInCurrentChat = null;
    private Int32 selectedChatId = -1;
    private String newMessageText = "";
    private Boolean sidebarOpen;
    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private String CurrentTitle =>
        userChats.FirstOrDefault(c => c.ChatId == selectedChatId)?.Title ?? "Новый чат";

    private String? newChatTitle = null;
    private Modal newChatModal = null!;

    private Boolean isAiThinking = false;
    private Boolean isImageMessage = false;
    private ReadOnlyMemory<Byte> imageBytes = default;
    private String? selectedImageFileName;

    
    private Boolean scrollRequested;

    private ElementReference messagesEl;
    private IJSObjectReference? jsModule;

    private readonly SemaphoreSlim aiLock = new(1, 1);

    protected override async Task OnAfterRenderAsync(Boolean firstRender)
    {
        if (!scrollRequested) return;
        scrollRequested = false;
        await ScrollToBottomAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var user = (await AuthTask).User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        userChats = await ChatRepo.GetAllChatsAsync();
    }

    private async Task OpenChat(Int32 chatId)
    {
        if (isAiThinking) return;
        if (selectedChatId == chatId) return;

        selectedChatId = chatId;
        var messages = await ChatRepo.GetAllMessagesInChatAsync(chatId);
        messagesInCurrentChat = messages.Messages;

        await ObamaAgent.ForcedCreatingSessionAsync();
        
        ObamaAgent.SetHistory(messages.Messages.AllocAsAgentAiMessageHistory());

        scrollRequested = true;
    }

    private async Task SendMessage()
    {
        if (String.IsNullOrWhiteSpace(newMessageText) || isAiThinking) return;

        if (selectedChatId == -1)
        {
            ShowMessage(GetDangerMessage("Сначала выберите или создайте чат", "Нет чата"));
            return;
        }

        var textMessage = newMessageText.Trim();
        newMessageText = String.Empty;

        var userMessage = new NewMessageDto
        {
            TextMessage = textMessage,
            TargetChatId = selectedChatId,
            Role = Role.User,
            CreatedAt = DateTime.Now
        };

       
        var userView = userMessage.AsViewMessageDto();
        messagesInCurrentChat?.Add(userView);
        scrollRequested = true;

        await SendMessagesAiAndApi(userMessage, userView);
    }

    private async Task SendMessagesAiAndApi(NewMessageDto userMessage, ViewMessageDto userView)
    {

        isAiThinking = true;
        scrollRequested = true;

        await aiLock.WaitAsync();
        try
        {

            try
            {
                await ChatRepo.SendMessageAsync(userMessage);
            }
            catch (Exception e)
            {
                messagesInCurrentChat?.Remove(userView);
                ShowMessage(GetDangerMessage(e.Message, "Не удалось отправить сообщение"));
                return;
            }

            
            try
            {
                // await Task.Delay(3000);
                var request = new AiRequest
                {
                    Prompt = userMessage.TextMessage,
                    ImageBytes = (isImageMessage && imageBytes.Length > 0) ? imageBytes : null,
                };
                Console.WriteLine(request.Prompt + "---------------------------------------------");
                var aiResponse = await ObamaAgent.UniversalSendMessageAsync(request);
                var aiMessage = new NewMessageDto
                {
                    TextMessage = aiResponse,
                    TargetChatId = userMessage.TargetChatId,
                    Role = Role.Ai,
                    CreatedAt = DateTime.Now
                };

                await ChatRepo.SendMessageAsync(aiMessage);
                messagesInCurrentChat?.Add(aiMessage.AsViewMessageDto());
                scrollRequested = true;
            }
            catch (Exception e)
            {
                ShowMessage(GetDangerMessage(e.Message, "Ошибка ответа ИИ"));
                Console.WriteLine(e.Message);
            }
        }
        finally
        {
            isAiThinking = false;
            scrollRequested = true;
            imageBytes = default;
            isImageMessage = false;
            selectedImageFileName = null;
            aiLock.Release();
        }
    }

    private static Boolean IsMine(ViewMessageDto m) => m.Role == Role.User;

    private async Task OpenNewChatModal()
    {
        newChatTitle = "";
        sidebarOpen = false;
        await newChatModal.ShowAsync();
    }

    private Task CloseNewChatModal() => newChatModal.HideAsync();

    private async Task SaveNewChat()
    {
        var title = newChatTitle?.Trim();
        if (String.IsNullOrWhiteSpace(title)) return;

        var newChat = await ChatRepo.CreateChatAsync(new CreateChatDto
        {
            ChatTitle = title,
        });

        if (newChat is null)
        {
            ShowMessage(GetDangerMessage("Неизвестная ошибка создания", "Ошибка добавления чата"));
            return;
        }

        userChats.Add(newChat);
        await newChatModal.HideAsync();
    }

    private void ShowMessage(ToastMessage message) => toastMessages.Add(message);

    private ToastMessage GetDangerMessage(String message, String title)
    {
        return new ToastMessage
        {
            Title = title,
            Type = ToastType.Danger,
            AutoHide = true,
            HelpText = $"{DateTime.Now.ToShortTimeString()}",
            Message = message
        };
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            jsModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Chat/Chat.razor.js");
            await jsModule.InvokeVoidAsync("scrollToBottom", messagesEl);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (jsModule is not null)
                await jsModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }

        aiLock.Dispose();
    }
    private async Task OnFileChange(InputFileChangeEventArgs arg)
    {
        isImageMessage = true;
        try
        {
            if (arg.File is null) return;

            var resizedFile = await arg.File.RequestImageFileAsync("image/jpeg", 400, 400);
            using var ms = new MemoryStream((Int32)resizedFile.Size);
            await resizedFile.OpenReadStream(1024 * 1024 * 15).CopyToAsync(ms);
            if (ms.TryGetBuffer(out var bytes))
            {
                imageBytes = bytes.AsMemory();
                selectedImageFileName = arg.File.Name;
            }
        }
        catch (Exception e)
        {
            ShowMessage(GetDangerMessage(e.Message, "Ошибка загрузки файла"));
            isImageMessage = false;
            selectedImageFileName = null;
            imageBytes = default;
            return;
        }
    }
    private async Task Callback(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }
}
