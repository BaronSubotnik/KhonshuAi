@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<div class="page">

    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" href="">Khonshu<span class="ai-prefix">Ai</span></a>

            <nav class="site-nav">
                <NavLink class="site-nav__link" href="" Match="NavLinkMatch.All">Главная</NavLink>
                <NavLink class="site-nav__link" href="/chat">Попробовать <span>Khonshu</span></NavLink>
            </nav>
            <AuthorizeView>
                <Authorized>
                    <div class="site-actions">
                        <a class="btn-pill" href="/profile">@context.User.Identity?.Name</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="site-actions">
                        <a class="btn-pill" href="/login">Войти</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>



        </div>
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>



</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
